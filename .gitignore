# ============================================================
# Sovereign AI Workbench — .gitignore
# Team: Quanta Codes | SIH 2026
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
wheels/
*.egg-link
.installed.cfg
lib/
lib64/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/
.env.local

# pytest
.pytest_cache/
.cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json

# ── Node / React / Vite ──────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/dist-ssr/
*.local

# ── Environment files ────────────────────────────────────────
# Keep .env.example committed; never commit real secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# ── OS files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.user
.vs/

# ── Docker ───────────────────────────────────────────────────
docker-compose.override.yml

# ── ChromaDB / Vector store data ─────────────────────────────
data/chroma/
rag/chroma_db/
*.chroma

# ── Ollama / Model files ──────────────────────────────────────
# Don't commit large model blobs
models/
*.gguf
*.bin
*.safetensors

# ── Generated output files ───────────────────────────────────
# Agent-generated documents should not be committed
generated/
output/
*.tmp

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Secrets / Keys ───────────────────────────────────────────
*.pem
*.key
*.cert
secrets.yaml
secrets.json
