# Sovereign AI Workbench — Environment Configuration
# Copy this file to .env to override defaults locally

HOST=0.0.0.0
PORT=8000

# Enable Service Fallbacks (True = seamless mock responses if external team services are offline)
ENABLE_SERVICE_FALLBACKS=True

# Team Module Microservice URLs
ROUTER_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8002
MULTIMODAL_SERVICE_URL=http://localhost:8003
