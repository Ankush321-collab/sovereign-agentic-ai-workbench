# ==============================================================================
# Sovereign AI Workbench — Docker Environment Variables
# ==============================================================================

# Server Network Bindings
HOST=0.0.0.0
PORT=8000

# Standalone Fallbacks (True enables local agentic fallbacks when microservices run in-process)
ENABLE_SERVICE_FALLBACKS=True

# ── Ollama Connection Mode ────────────────────────────────────────────────────
# Option 1: Use the containerized Ollama instance (Default)
OLLAMA_BASE_URL=http://ollama:11434

# Option 2: Use your Windows host's Ollama instance (avoids re-downloading models!)
# Uncomment the line below if you run `ollama serve` on your Windows machine:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Internal Microservice Routing (Defaulting to in-process unified backend endpoints)
ROUTER_SERVICE_URL=http://backend:8000
RAG_SERVICE_URL=http://backend:8000
MULTIMODAL_SERVICE_URL=http://backend:8000

# ── Frontend Configuration ────────────────────────────────────────────────────
# Empty string instructs the SPA to make relative API requests,
# cleanly reverse-proxied by Nginx to the backend container.
VITE_API_URL=
VITE_USE_MOCK=false
