# ==============================================================================
# Sovereign AI Workbench — Docker Environment Variables
# ==============================================================================

# Server Network Bindings
HOST=0.0.0.0
PORT=8000

# Standalone Fallbacks (True enables local agentic fallbacks when microservices run in-process)
ENABLE_SERVICE_FALLBACKS=True

# ── Ollama Connection Mode ────────────────────────────────────────────────────
# Using host Windows Ollama instance directly (models already downloaded locally)
# Make sure `ollama serve` is running on your Windows machine before starting Docker.
# Available models: qwen2.5vl:7b | qwen2.5:7b-instruct | qwen2.5-coder:latest
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── Local Model & Microservice Endpoints ─────────────────────────────────────
# Sarvam Local Model Endpoint (routes to host machine on port 8001)
SARVAM_SERVICE_URL=http://host.docker.internal:8001
SARVAM_ENDPOINT=http://host.docker.internal:8001

# Internal Microservice Routing (inprocess avoids circular network calls inside the container)
ROUTER_SERVICE_URL=inprocess
RAG_SERVICE_URL=inprocess
MULTIMODAL_SERVICE_URL=inprocess

# ── Frontend Configuration ────────────────────────────────────────────────────
# Empty string instructs the SPA to make relative API requests,
# cleanly reverse-proxied by Nginx to the backend container.
VITE_API_URL=
VITE_USE_MOCK=false
